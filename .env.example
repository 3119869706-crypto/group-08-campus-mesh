# 服务端
PORT=3000
NODE_ENV=development

# 数据库（开发期 SQLite；部署期改为 MySQL 连接串）
DATABASE_URL=file:./data/campusmesh.sqlite
# DATABASE_URL=mysql://user:password@localhost:3306/campusmesh

# 匿名身份令牌
JWT_SECRET=change-me-to-a-random-32-byte-string
TOKEN_TTL=86400

# 大模型（OpenAI 兼容接口）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# STUN / TURN
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME= campusmesh
TURN_PASSWORD=change-me

# 前端
VITE_API_BASE=http://localhost:3000/api/v1
VITE_WS_BASE=ws://localhost:3000/ws
